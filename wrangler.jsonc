{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visionary",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-16",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {"pattern": "getvisionarywebstudio.com/*", "zone_name": "getvisionarywebstudio.com"},
    {"pattern": "www.getvisionarywebstudio.com/*", "zone_name": "getvisionarywebstudio.com"}
  ]
}
